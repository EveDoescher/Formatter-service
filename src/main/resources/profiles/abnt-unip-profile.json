  "componentRules": {
    "cover": {
      "componentId": "cover",
      "contentBindings": {
        "institutionalLines": "work.institutionalLines",
        "authors": "work.authors",
        "title": "work.title",
        "subtitle": "work.subtitle",
        "city": "work.city",
        "year": "work.year"
      },
      "styleMapping": {
        "institutionalLinesStyleId": "cover.top",
        "authorsStyleId": "cover.author",
        "titleStyleId": "cover.title",
        "subtitleStyleId": "cover.subtitle",
        "cityStyleId": "cover.bottom",
        "yearStyleId": "cover.bottom"
      },
      "layoutRule": {
        "groups": [
          {
            "id": "cover.institution",
            "required": true,
            "items": [
              {
                "id": "institutionalLines",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.authors",
            "required": false,
            "items": [
              {
                "id": "authors",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.titleBlock",
            "required": true,
            "items": [
              {
                "id": "title",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              },
              {
                "id": "subtitle",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.bottom",
            "required": true,
            "items": [
              {
                "id": "city",
                "required": true,
                "maxVisualLinesPerValue": 1,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              },
              {
                "id": "year",
                "required": true,
                "maxVisualLinesPerValue": 1,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          }
        ],
        "gapRules": [
          {
            "fromGroupId": "cover.institution",
            "toGroupId": "cover.authors",
            "weight": 30
          },
          {
            "fromGroupId": "cover.authors",
            "toGroupId": "cover.titleBlock",
            "weight": 10
          },
          {
            "fromGroupId": "cover.titleBlock",
            "toGroupId": "cover.bottom",
            "weight": 60
          }
        ],
        "policy": {
          "anchorStrategy": "LAST_GROUP_AT_SAFE_AREA_END",
          "lineHeightStrategy": "MAX_EXACT_LINE_HEIGHT",
          "spacerStylePolicy": "NEXT_GROUP_STYLE",
          "safetyPolicy": "MARGIN_BASED"
        }
      }
    },
    "titlePage": {
      "componentId": "titlePage",
      "contentBindings": {
        "authors": "work.authors",
        "title": "work.title",
        "subtitle": "work.subtitle",
        "nature": "work.nature",
        "advisor": "work.advisor",
        "coadvisor": "work.coadvisor",
        "city": "work.city",
        "year": "work.year"
