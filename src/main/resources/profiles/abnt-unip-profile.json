                "required": true,
                "maxVisualLinesPerValue": 1,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          }
        ],
        "gapRules": [
          {
            "fromGroupId": "titlePage.authors",
            "toGroupId": "titlePage.titleBlock",
            "weight": 20
          },
          {
            "fromGroupId": "titlePage.titleBlock",
