  "componentRules": {
    "cover": {
      "componentId": "cover",
      "styleMapping": {
        "institutionalLinesStyleId": "cover.top",
        "authorsStyleId": "cover.author",
        "titleStyleId": "cover.title",
        "subtitleStyleId": "cover.subtitle",
        "cityStyleId": "cover.bottom",
        "yearStyleId": "cover.bottom"
      },
      "layoutRule": {
        "groups": [
          {
            "id": "cover.institution",
            "required": true,
            "items": [
              {
                "id": "institutionalLines",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.authors",
            "required": false,
            "items": [
              {
                "id": "authors",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.titleBlock",
            "required": true,
            "items": [
              {
                "id": "title",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              },
              {
                "id": "subtitle",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "cover.bottom",
            "required": true,
            "items": [
              {
                "id": "city",
                "required": true,
                "maxVisualLinesPerValue": 1,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              },
              {
                "id": "year",
                "required": true,
                "maxVisualLinesPerValue": 1,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          }
        ],
        "gapRules": [
          {
            "fromGroupId": "cover.institution",
            "toGroupId": "cover.authors",
            "weight": 30
          },
          {
            "fromGroupId": "cover.authors",
            "toGroupId": "cover.titleBlock",
            "weight": 10
          },
          {
            "fromGroupId": "cover.titleBlock",
            "toGroupId": "cover.bottom",
            "weight": 60
          }
        ],
        "policy": {
          "anchorStrategy": "LAST_GROUP_AT_SAFE_AREA_END",
          "lineHeightStrategy": "MAX_EXACT_LINE_HEIGHT",
          "spacerStylePolicy": "NEXT_GROUP_STYLE",
          "safetyPolicy": "MARGIN_BASED"
        }
      }
    },
    "titlePage": {
      "componentId": "titlePage",
      "styleMapping": {
        "authorsStyleId": "titlePage.author",
        "titleStyleId": "titlePage.title",
        "subtitleStyleId": "titlePage.subtitle",
        "natureStyleId": "titlePage.nature",
        "advisorStyleId": "titlePage.advisor",
        "coadvisorStyleId": "titlePage.coadvisor",
        "cityStyleId": "titlePage.bottom",
        "yearStyleId": "titlePage.bottom"
      },
      "textTemplates": {
        "natureTemplate": "{workType} para {degreeObjective} em {courseName} apresentado \u00e0 {institutionName}.",
        "advisorTemplate": "Orientador(a): {academicTitle} {name}.",
        "coadvisorTemplate": "Coorientador(a): {academicTitle} {name}."
      },
      "layoutRule": {
        "groups": [
          {
            "id": "titlePage.authors",
            "required": true,
            "items": [
              {
                "id": "authors",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "titlePage.titleBlock",
            "required": true,
            "items": [
              {
                "id": "title",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              },
              {
                "id": "subtitle",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FULL_CONTENT_WIDTH"
                }
              }
            ]
          },
          {
            "id": "titlePage.natureBlock",
            "required": true,
            "items": [
              {
                "id": "nature",
                "required": true,
                "horizontalPlacement": {
                  "strategy": "FROM_PAGE_CENTER_TO_RIGHT_MARGIN"
                },
                "blankLinesAfter": 1
              },
              {
                "id": "advisor",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FROM_PAGE_CENTER_TO_RIGHT_MARGIN"
                },
                "blankLinesAfter": 1
              },
              {
                "id": "coadvisor",
                "required": false,
                "horizontalPlacement": {
                  "strategy": "FROM_PAGE_CENTER_TO_RIGHT_MARGIN"
                }
              }
            ]
          },
          {
            "id": "titlePage.bottom",
            "required": true,
            "items": [
              {
                "id": "city",
